# Caddyfile inside qouver-web container (Podman)
:80 {
    root * /srv
    encode zstd gzip

    # Clean URLs: /projects → /projects.html or /projects/index.html
    try_files {path} {path}.html {path}/index.html

    file_server

    handle_errors {
        @404 expression {http.error.status_code} == 404
        rewrite @404 /404.html
        file_server
    }
}
