# Quadlet unit for qouver-api: podman + systemd user
# Path on VPS: ~/.config/containers/systemd/qouver-api.container
[Unit]
Description=Qouver API (qouver.com, Nim + PostgreSQL)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/nferdazel/qouver-api:main
ContainerName=qouver-api
Network=qouver
PublishPort=127.0.0.1:8091:8091
Environment=QOUVER_HOST=0.0.0.0
Environment=QOUVER_PORT=8091
EnvironmentFile=%h/.config/qouver/qouver-api.env
AutoUpdate=registry

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
