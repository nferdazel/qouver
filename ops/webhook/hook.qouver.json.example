[
  {
    "id": "qouver",
    "execute-command": "/srv/qouver/apps/qouver/scripts/deploy-vps.sh",
    "command-working-directory": "/srv/qouver/apps/qouver",
    "pass-arguments-to-command": [
      {
        "source": "payload",
        "name": "repository.name"
      },
      {
        "source": "payload",
        "name": "ref"
      }
    ],
    "trigger-rule": {
      "match": {
        "type": "payload-hmac-sha256",
        "secret": "YOUR_WEBHOOK_HMAC_SECRET",
        "parameter": {
          "source": "header",
          "name": "X-Hub-Signature-256"
        }
      }
    }
  }
]
