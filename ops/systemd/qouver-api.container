# Quadlet unit for qouver-api: podman + systemd user
# Path on VPS: ~/.config/containers/systemd/qouver-api.container
[Unit]
OnFailure=alert@%N.service
Description=Qouver API (qouver.com, Nim + PostgreSQL)
# network-online.target says the network is up, not that PostgreSQL accepts
# sessions. Without this ordering the API starts before the database on every
# boot, logs "Failed to connect to PostgreSQL ... falling back to memory data",
# and serves from memory until someone restarts it (seen on the 2026-11-26
# 16:44 reboot: unit came up unhealthy, one manual restart was needed).
Wants=network-online.target qouver-postgres.service
After=network-online.target qouver-postgres.service
[Container]
Image=localhost/qouver-api:local
ContainerName=qouver-api
Network=qouver
PublishPort=127.0.0.1:8091:8091
Pull=never
EnvironmentFile=/srv/qouver/apps/qouver/env/qouver-prod.env
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
Tmpfs=/tmp
# RT-06: the status line alone is not readiness. /healthz answers 200 while the body says
# "database":"disconnected" (seen 2026-11-12 16:21, qouver-api lost the DNS race at boot and
# fell back to memory data), so this check fails on that word. The image carries wget + grep,
# no curl, no bash.
HealthCmd=/bin/sh -c "wget -q -O- -T 5 http://127.0.0.1:8091/healthz | grep -qv disconnected"
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=45s
PidsLimit=256
[Service]
Restart=always
RestartSec=3
MemoryMax=512M
[Install]
WantedBy=default.target
