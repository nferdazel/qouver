# qouver — production env template for /srv/qouver/apps/qouver/env/qouver-prod.env
#
# The real file lives only on qouver1 (mode 0600, owner sachiel) and is read by
# ops/systemd/qouver-api.container via EnvironmentFile=. Nothing in the repo carries
# a value from it. Copy this file there once, fill in the DSN, then `daemon-reload`
# and restart qouver-api.
#
# Keys confirmed against the live file on 2026-11-20 (four keys, no more).

# Runtime profile. `production` is what the host runs.
QOUVER_ENV=production

# Listen address inside the container. The quadlet publishes 127.0.0.1:8091, so the
# process may bind 0.0.0.0 without exposing anything — the host port is loopback only.
QOUVER_HOST=0.0.0.0
QOUVER_PORT=8091

# Postgres connection string, libpq key=value form (not a URL — the live file uses this shape).
# The cluster is the shared qouver-postgres container; the role is `qouver`, never `postgres`
# (that role cannot log in). Keep the password out of the file in git.
QOUVER_DATABASE_URL=host=qouver-postgres port=5432 user=qouver password=REPLACE_ME dbname=qouver
